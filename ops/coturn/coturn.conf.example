# Render this file to /etc/turnserver.conf with setup-coturn.sh.
# coturn must run on an external VPS: Replit's HTTP proxy does not expose UDP.
listening-port=3478
tls-listening-port=443
listening-ip=0.0.0.0
relay-ip=PUBLIC_OR_PRIVATE_BIND_IP
external-ip=PUBLIC_IP
min-port=49160
max-port=49260

fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=GENERATED_SECRET
realm=TURN_HOSTNAME
server-name=TURN_HOSTNAME

cert=/etc/coturn/certs/fullchain.pem
pkey=/etc/coturn/certs/privkey.pem
no-tlsv1
no-tlsv1_1
cipher-list="HIGH:!aNULL:!MD5:!3DES"

no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

stale-nonce=600
user-quota=12
total-quota=1200
max-bps=2000000
no-cli
no-software-attribute
log-file=syslog
simple-log
