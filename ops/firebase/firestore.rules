rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasLiveServerSession() {
      return request.auth != null
        && request.auth.token.sessionTag is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.auth.token.sessionTag))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.auth.token.sessionTag)).data.revokedAt == null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.auth.token.sessionTag)).data.expiresAt > request.time;
    }

    // The server creates and changes invitations. A Firebase custom token has a
    // numeric userId claim matching one of the canonical invitation participants.
    match /callInvites/{callId} {
      allow get, list: if hasLiveServerSession()
        && (resource.data.fromId == request.auth.token.userId
          || resource.data.toId == request.auth.token.userId);
      allow create, update, delete: if false;
    }

    // Firebase Auth UID is String(PostgreSQL user id). Device-token documents
    // are server-managed and are deliberately not readable by the browser.
    match /users/{userId}/devices/{installationId} {
      allow read, write: if false;
    }

    match /users/{userId}/missedCalls/{callId} {
      allow get, list: if hasLiveServerSession() && request.auth.uid == userId;
      // The server owns lifecycle fields. A client may only acknowledge its
      // own inbox item; all other writes remain server-mediated.
      allow update: if hasLiveServerSession() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seen"])
        && request.resource.data.seen == true;
      allow create, delete: if false;
    }

    match /users/{userId}/sessions/{sessionTag} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }
  }
}