modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "222211wx@gmail.com"
GIPHY_API_KEY = "dc6zaT0xFJmzC"
AGORA_APP_ID = "62585b9b53c44c47baa7600ee5d74e54"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19130
externalPort = 3001

[[ports]]
localPort = 22842
externalPort = 3000

[[ports]]
localPort = 23916
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-fe0a3e61-810d-4ac9-bd98-f324eacc3236"
