{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. Extracted from the Arena Qaisypro app (artifacts/gdna-arena): the app is dark-only (pure black + imperial gold #C9A84C + neon blue #00d4ff); the dark set is source-faithful, the light set is DERIVED (warm ivory + darkened gold for contrast).",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#faf8f2" },
      "foreground": { "$value": "#17130d" },
      "border": { "$value": "#e6dcc3" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#17130d" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#17130d" },
      "primary": {
        "$value": "#a67c2e",
        "$description": "Imperial gold, darkened for light-mode contrast (source gold is #C9A84C)."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#f3edda" },
      "secondaryForeground": { "$value": "#17130d" },
      "muted": { "$value": "#f0ead6" },
      "mutedForeground": { "$value": "#6b6046" },
      "accent": { "$value": "#0891b2" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#dc2626" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e6dcc3" },
      "ring": { "$value": "#a67c2e" },
      "chart1": { "$value": "#a67c2e" },
      "chart2": { "$value": "#0891b2" },
      "chart3": { "$value": "#16a34a" },
      "chart4": { "$value": "#9333ea" },
      "chart5": { "$value": "#dc2626" },
      "sidebar": { "$value": "#f6f1e3" },
      "sidebarForeground": { "$value": "#3d3421" },
      "sidebarBorder": { "$value": "#e6dcc3" },
      "sidebarPrimary": { "$value": "#a67c2e" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#ece2c8" },
      "sidebarAccentForeground": { "$value": "#17130d" },
      "sidebarRing": { "$value": "#a67c2e" }
    },
    "dark": {
      "background": { "$value": "#000000" },
      "foreground": { "$value": "#ffffff" },
      "border": { "$value": "#3d3421" },
      "card": { "$value": "#0d0d0d" },
      "cardForeground": { "$value": "#ffffff" },
      "popover": { "$value": "#0d0d0d" },
      "popoverForeground": { "$value": "#ffffff" },
      "primary": {
        "$value": "#c9a84c",
        "$description": "Imperial gold — the empire's signature (nav, buttons, crown)."
      },
      "primaryForeground": { "$value": "#000000" },
      "secondary": { "$value": "#1a1a1a" },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#262626" },
      "mutedForeground": { "$value": "#b3b3b3" },
      "accent": { "$value": "#00d4ff" },
      "accentForeground": { "$value": "#000000" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#3d3421" },
      "ring": { "$value": "#c9a84c" },
      "chart1": { "$value": "#c9a84c" },
      "chart2": { "$value": "#00d4ff" },
      "chart3": { "$value": "#25d366" },
      "chart4": { "$value": "#a855f7" },
      "chart5": { "$value": "#ef4444" },
      "sidebar": { "$value": "#0d0d0d" },
      "sidebarForeground": { "$value": "#ffffff" },
      "sidebarBorder": { "$value": "#3d3421" },
      "sidebarPrimary": { "$value": "#c9a84c" },
      "sidebarPrimaryForeground": { "$value": "#000000" },
      "sidebarAccent": { "$value": "#1f1a10" },
      "sidebarAccentForeground": { "$value": "#e7ce8b" },
      "sidebarRing": { "$value": "#c9a84c" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface (loaded by the source app)."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
