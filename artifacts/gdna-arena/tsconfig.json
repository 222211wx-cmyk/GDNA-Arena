{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "noEmit": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": [
        "./src/components/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "checkJs": false
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
