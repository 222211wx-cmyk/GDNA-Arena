{
  "expo": {
    "name": "Arena Qaisypro",
    "slug": "gdna-arena-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gdna-arena-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8f2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gdna.arena.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Arena Qaisypro to use your microphone for encrypted Agora calls.",
        "NSCameraUsageDescription": "Allow Arena Qaisypro to use your camera for encrypted Agora video calls."
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#faf8f2"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://helixly.app/"
        }
      ],
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Arena Qaisypro to select an image to encrypt and send."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
