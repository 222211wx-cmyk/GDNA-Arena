{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm run typecheck && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:ppo": "rm -rf .ppo-test-dist && tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --outDir .ppo-test-dist src/lib/ppo-transaction.ts src/lib/ppo-wallet-allocation.ts src/lib/ppo-payout.test.ts && node --test .ppo-test-dist/ppo-payout.test.js && rm -rf .ppo-test-dist",
    "test:firebase-probe": "node scripts/firebase-call-push-probe.mjs",
    "test:clip-media": "sh -c 'trap \"rm -rf .clip-media-test-dist\" EXIT; tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --outDir .clip-media-test-dist src/lib/clip-duration.test.ts src/lib/clip-thumbnail.test.ts && node --test .clip-media-test-dist/*.test.js'",
    "typecheck": "tsc -b ../../lib/db ../../lib/api-zod && tsc -p tsconfig.json --noEmit",
    "test:integration": "node --test tests/*.integration.test.mjs",
    "test:integration:thumbnail-retry": "node --test tests/clips-thumbnail-retry.integration.test.mjs tests/clips-storage-cleanup.integration.test.mjs",
    "test:integration:account-erasure": "node --test tests/auth-delete.integration.test.mjs",
    "test:integration:conversation-exit": "node --test tests/messages-room-exit.integration.test.mjs",
    "test:integration:citizens-list": "node --test tests/citizens-list.integration.test.mjs",
    "test:integration:rooms-order": "node --test tests/messages-rooms-order.integration.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/multer": "^2.2.0",
    "@types/ws": "^8.18.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "agora-token": "^2.0.5",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
